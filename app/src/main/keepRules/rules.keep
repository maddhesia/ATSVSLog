# ATSVSLog M16 release-hardening keep rules.
#
# Gson materializes these classes reflectively from JSON. Keep their class
# and field names stable in the release build so report/diagnostics decoding
# remains functional after R8 optimization/obfuscation.

# Network envelope and sync payload DTOs.
-keep class com.sma.atsvslog.network.dto.** { *; }

# Daily Report Gson models.
-keep class com.sma.atsvslog.features.report.DailyReport { *; }
-keep class com.sma.atsvslog.features.report.MerchandiseSold { *; }
-keep class com.sma.atsvslog.features.report.ReportItem { *; }
-keep class com.sma.atsvslog.features.report.MonthToDate { *; }

# Diagnostics Gson models.
-keep class com.sma.atsvslog.diagnostics.DiagnosticLogEntry { *; }
-keep class com.sma.atsvslog.diagnostics.DiagnosticLastError { *; }
